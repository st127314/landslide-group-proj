# PUBLIC repo = apps/, notebooks/, tests/, docs/, scripts/, model-ready tables in data/processed/,
# experiment outputs, figures and model metadata (+ README.md, requirements.txt).
# Raw data (inventory, Earth Engine samples, external layers), trained models, the scored map and credentials stay local.
# Whitelist approach: ignore everything at the top level, then re-include only the public parts.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/apps/
!/notebooks/
!/tests/

# Final, model-ready datasets and project documents (shared with the team)
!/data/
/data/*
!/data/DATA_DICTIONARY.md
!/data/processed/
/data/processed/*
!/data/processed/landslide_event_factors_cleaned.csv
!/data/processed/landslide_event_antecedent_rainfall.csv
!/data/processed/non_landslide_event_antecedent_rainfall.csv
!/data/processed/landslide_event_factors_cleaning_report.txt
!/data/processed/legacy_random_negatives_factors_cleaned.csv
!/docs/
!/scripts/
!/requirements.txt
# Supplementary experiment outputs, figures and model metadata (no trained model files, no scored map)
!/results/
/results/*
!/results/experiments/
!/results/figures/
!/models/
/models/*
!/models/susceptibility/
/models/susceptibility/*
!/models/susceptibility/model_metadata.json
!/models/rainfall_trigger/
/models/rainfall_trigger/*
!/models/rainfall_trigger/rainfall_trigger_metadata.json
/docs/inventory_date_audit.csv
/docs/~$*
docs/draft/

# Never track these, even inside the public folders
node_modules/
.next/
out/
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.matplotlib_cache/
.env
.env.*
*.log
.DS_Store
*.tsbuildinfo
next-env.d.ts
# Generated by `next dev` for AI coding tools; not part of the project
apps/frontend/AGENTS.md

# Data, models, outputs and credentials must never appear under the public folders either
*.joblib
*.tif
*.gpkg
*.geojson
*.zip
service_account/
key.json
*privatekey*.json
*.pem
*.key
id_rsa*
active.conf
